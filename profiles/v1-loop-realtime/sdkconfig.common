CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="profiles/v1-loop-realtime/partitions.csv"
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_GM_SYNTH_QEMU_FLASH_SF2_TEST=n
CONFIG_GM_SYNTH_I2S_QUAL_MASTER_GAIN_Q15=32767
CONFIG_GM_SYNTH_I2S_QUAL_DAC_ATTENUATION_DB=12
CONFIG_GM_SYNTH_I2S_QUAL_MCLK_GPIO=16
CONFIG_GM_SYNTH_I2S_QUAL_BCLK_GPIO=9
CONFIG_GM_SYNTH_I2S_QUAL_WS_GPIO=45
CONFIG_GM_SYNTH_I2S_QUAL_DOUT_GPIO=8
CONFIG_GM_SYNTH_I2S_QUAL_DMA_DESC_NUM=8
CONFIG_GM_SYNTH_I2S_QUAL_DMA_FRAME_NUM=64
CONFIG_GM_SYNTH_I2S_QUAL_TASK_CORE=1
CONFIG_GM_SYNTH_I2S_QUAL_TASK_PRIORITY=20
CONFIG_GM_SYNTH_I2S_QUAL_TASK_STACK_BYTES=8192
CONFIG_GM_SYNTH_I2S_QUAL_MIN_STACK_HEADROOM_BYTES=2048
CONFIG_GM_SYNTH_I2S_QUAL_WRITE_TIMEOUT_MS=20
