# Reference target: ESP32-S3-WROOM-1-N16R8
# 16 MB Quad-SPI flash + 8 MB Octal-SPI PSRAM.
# Final production sdkconfig must still be validated against the exact module SKU.

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Audio/DSP timing qualification must use the same optimized build class that
# will ship on hardware. ESP-IDF otherwise defaults this project to DEBUG/-Og,
# which is useful for source debugging but invalid as a polyphony oracle.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# Allow the compiler to inline hot audio calls across translation units. The
# realtime path is split across VoiceRenderer / VoiceEffectsBus / scheduled
# renderer files, so compile-time + link-time LTO is part of the production
# performance configuration rather than a benchmark-only switch.
CONFIG_COMPILER_LTO_LINKTIME=y
CONFIG_COMPILER_LTO_COMPILETIME=y

# Pin the physical-storage timing baseline explicitly. These are ESP-IDF v6.1
# defaults for ESP32-S3, but keeping them here prevents a future IDF/default
# change from silently invalidating Flash -> PSRAM benchmark comparisons.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
