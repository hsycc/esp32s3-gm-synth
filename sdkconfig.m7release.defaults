# Dedicated physical ESP32-S3 N16R8 M7 release long-run image.
# This is intentionally separate from sdkconfig.hwbench.defaults so the routine
# M6 physical build keeps its established 16384-block (~23.78 s) baseline.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_qemu.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_qemu.csv"

CONFIG_GM_SYNTH_PCM_ARENA_BYTES=4718592
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_GM_SYNTH_STORAGE_BENCHMARK_ENABLE=y
CONFIG_GM_SYNTH_STORAGE_BENCHMARK_PATH="/sf2/test.sf2"
CONFIG_GM_SYNTH_STORAGE_BENCHMARK_BYTES=4194304
CONFIG_GM_SYNTH_PROGRAM_PREPARE_BENCHMARK_ENABLE=y

CONFIG_GM_SYNTH_RENDER_BENCHMARK_ENABLE=y
CONFIG_GM_SYNTH_PHYSICAL_QUALIFICATION_BUILD=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_TASK_WDT_PANIC=y

CONFIG_GM_SYNTH_I2S_QUAL_ENABLE=y
CONFIG_GM_SYNTH_I2S_QUAL_MCLK_GPIO=16
CONFIG_GM_SYNTH_I2S_QUAL_BCLK_GPIO=9
CONFIG_GM_SYNTH_I2S_QUAL_WS_GPIO=45
CONFIG_GM_SYNTH_I2S_QUAL_DOUT_GPIO=8
CONFIG_GM_SYNTH_I2S_QUAL_DMA_DESC_NUM=8
CONFIG_GM_SYNTH_I2S_QUAL_DMA_FRAME_NUM=64
CONFIG_GM_SYNTH_I2S_QUAL_TASK_CORE=1
CONFIG_GM_SYNTH_I2S_QUAL_TASK_PRIORITY=20

# 131072 * 64 / 44100 = 190.22 s of measured continuous physical streaming.
# PhysicalMusicStress places its 118-event production-shaped phases relative to
# the configured measured window, so sustain/release, 24-voice bursts, Program
# Change and GM Reset remain distributed through the full long-run interval.
CONFIG_GM_SYNTH_I2S_QUAL_MEASURE_BLOCKS=131072

CONFIG_GM_SYNTH_QEMU_FLASH_SF2_TEST=y
