     std::int32_t velocity_to_vol_env_attack_timecents = 0;
     NoteOnGainConfig note_on_gain{};
     NoteOnFilterConfig note_on_filter{};
+    // Immutable key/velocity modulation for generator destinations that are
+    // evaluated once at NoteOn. No allocation or bank parsing occurs here.
+    sf2::Sf2PreparedNoteOnModulatorSet prepared_note_on_modulators{};
     VibratoLfoConfig vibrato_lfo{};
     ModLfoConfig mod_lfo{};
     ModEnvelopeConfig mod_envelope{};
     EffectsSendConfig effects_send{};
 
+    bool preparedNoteOnModulatorsValid() const {
+        if (!prepared_note_on_modulators.valid()) {
+            return false;
+        }
+        for (std::size_t index = 0; index < prepared_note_on_modulators.count; ++index) {
+            if (!sf2::isRuntimeGenericPreparedNoteOnRoute(
+                    prepared_note_on_modulators.routes[index])) {
+                return false;
+            }
+        }
+        return true;
+    }
+
     bool valid() const {
         const bool sample_region_valid = !sample_region.enabled ||
             (sample_region.start_frame < sample_region.end_frame &&
@@ -208,6 +226,7 @@
                root_key <= 127 && scale_tuning_cents_per_key <= 1200 &&
                root_phase_increment_q32 != 0 && sample_region_valid &&
                note_on_gain.valid() && note_on_filter.valid() &&
+               preparedNoteOnModulatorsValid() &&
                vibrato_lfo.valid() && mod_lfo.valid() &&
                mod_envelope.valid() && effects_send.valid();
     }
diff -ruN '--exclude=*.o' s3orig/firmware/gm/ZoneResolver.cpp s3src/firmware/gm/ZoneResolver.cpp
--- s3orig/firmware/gm/ZoneResolver.cpp	2026-10-21 03:52:34.000000000 +0000
+++ s3src/firmware/gm/ZoneResolver.cpp	2026-10-21 03:55:28.809351974 +0000
@@ -76,15 +76,36 @@
         : velocity;
 }
 
-std::uint64_t keyTrackedPhaseIncrement(const PlaybackZone& zone, std::uint8_t key) {
-    if (!zone.key_tracking) {
-        return zone.root_phase_increment_q32;
-    }
-    const int key_delta = static_cast<int>(key) - static_cast<int>(zone.root_key);
-    const int cents_delta = key_delta * static_cast<int>(zone.scale_tuning_cents_per_key);
-    return cents_delta == 0
-        ? zone.root_phase_increment_q32
-        : ZoneResolver::transposeCents(zone.root_phase_increment_q32, cents_delta);
+sf2::Sf2NoteOnTargetDeltas preparedNoteOnTargetDeltas(
+    const PlaybackZone& zone,
+    std::uint8_t key,
+    std::uint8_t effective_velocity) {
+    sf2::Sf2NoteOnTargetDeltas deltas{};
+    for (std::size_t index = 0; index < zone.prepared_note_on_modulators.count; ++index) {
+        (void)sf2::applyPreparedNoteOnModulator(
+            zone.prepared_note_on_modulators.routes[index],
+            key,
+            effective_velocity,
+            &deltas);
+    }
+    return deltas;
+}
+
+std::uint64_t keyTrackedPhaseIncrement(
+    const PlaybackZone& zone,
+    std::uint8_t key,
+    std::int32_t fine_tune_cents) {
+    std::uint64_t increment = zone.root_phase_increment_q32;
+    if (zone.key_tracking) {
+        const int key_delta = static_cast<int>(key) - static_cast<int>(zone.root_key);
+        const int cents_delta = key_delta * static_cast<int>(zone.scale_tuning_cents_per_key);
+        if (cents_delta != 0) {
+            increment = ZoneResolver::transposeCents(increment, cents_delta);
+        }
+    }
+    return fine_tune_cents == 0
+        ? increment
+        : ZoneResolver::transposeCents(increment, fine_tune_cents);
 }
 
