+    // Optional control-domain-built key -> zone reference index. It becomes
+    // mandatory above kMaxLinearScanZones. The pointed-to arrays share the same
+    // READY/Active/Retired lifetime contract as zones.
+    const PlaybackProgramKeySpan* key_spans = nullptr;
+    const std::uint16_t* key_zone_indices = nullptr;
+    std::uint32_t key_reference_count = 0;
+    std::uint16_t max_key_candidates = 0;
+
+    bool hasKeyIndex() const {
+        return key_spans != nullptr || key_zone_indices != nullptr ||
+            key_reference_count != 0 || max_key_candidates != 0;
+    }
+
+    bool keyIndexValid() const {
+        if (!hasKeyIndex()) {
+            return zone_count <= kMaxLinearScanZones;
+        }
+        if (key_spans == nullptr || key_zone_indices == nullptr ||
+            zone_count == 0 || key_reference_count == 0) {
+            return false;
+        }
+
+        std::uint64_t expected_references = 0;
+        std::array<std::uint16_t, kPlaybackProgramMidiKeyCount> expected_counts{};
+        for (std::size_t zone_index = 0; zone_index < zone_count; ++zone_index) {
+            const PlaybackZone& zone = zones[zone_index];
+            expected_references +=
+                static_cast<std::uint32_t>(zone.key_high - zone.key_low) + 1u;
+            if (expected_references > std::numeric_limits<std::uint32_t>::max()) {
+                return false;
+            }
+            for (std::uint16_t key = zone.key_low; key <= zone.key_high; ++key) {
+                ++expected_counts[key];
+            }
+        }
+        if (expected_references != key_reference_count) {
+            return false;
+        }
+
+        std::uint16_t observed_max = 0;
+        for (std::size_t key = 0; key < kPlaybackProgramMidiKeyCount; ++key) {
+            const PlaybackProgramKeySpan& span = key_spans[key];
+            if (span.begin > key_reference_count ||
+                span.count > key_reference_count - span.begin ||
+                span.count != expected_counts[key]) {
+                return false;
+            }
+            observed_max = std::max(observed_max, span.count);
+            std::uint16_t previous = 0;
+            bool have_previous = false;
+            for (std::size_t offset = 0; offset < span.count; ++offset) {
+                const std::uint16_t zone_index = key_zone_indices[span.begin + offset];
+                if (zone_index >= zone_count ||
+                    key < zones[zone_index].key_low || key > zones[zone_index].key_high ||
+                    (have_previous && zone_index <= previous)) {
+                    return false;
+                }
+                previous = zone_index;
+                have_previous = true;
+            }
+        }
+        return observed_max == max_key_candidates;
+    }
+
     bool valid() const {
         if (channel >= 16 || token == 0 || bank_generation == 0 ||
             zone_count > kMaxZones || (zone_count != 0 && zones == nullptr)) {
