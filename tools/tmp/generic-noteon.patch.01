+    std::uint16_t destination_oper) {
+    for (std::size_t index = 0; index < routes.count; ++index) {
+        if (routes.routes[index].destination_oper == destination_oper) {
+            return true;
+        }
+    }
+    return false;
+}
+
 }  // namespace
 
