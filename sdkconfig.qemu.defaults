# Dedicated ESP32-S3 QEMU integration build. These settings are layered on top
# of sdkconfig.defaults and never replace the production/default sdkconfig.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_qemu.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_qemu.csv"

CONFIG_GM_SYNTH_STORAGE_BENCHMARK_ENABLE=y
CONFIG_GM_SYNTH_STORAGE_BENCHMARK_PATH="/sf2/test.sf2"
# QEMU validates the complete VFS -> real SF2 smpl -> PSRAM code path, but its
# emulated SPI-flash timing is not representative of N16R8 hardware. Keep the
# functional sweep deliberately small so CI still covers every 4/8/16/32/64 KiB
# chunk size without spending the job timeout rereading 20 MiB in emulation.
CONFIG_GM_SYNTH_STORAGE_BENCHMARK_BYTES=262144

# Also exercise the M3 control/storage transaction path in emulation. Timing is
# functional telemetry only; physical N16R8 remains the performance oracle.
CONFIG_GM_SYNTH_PROGRAM_PREPARE_BENCHMARK_ENABLE=y

# Exercise the actual scheduler + Voice DSP + mix/finalize timed-render path at
# fixed Voice counts. QEMU times are version-to-version regression telemetry,
# never a substitute for N16R8 CPU/I2S qualification.
CONFIG_GM_SYNTH_RENDER_BENCHMARK_ENABLE=y

CONFIG_GM_SYNTH_QEMU_FLASH_SF2_TEST=y
